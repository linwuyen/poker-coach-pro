# Optional. Offline coach mode works without an API key.
GEMINI_API_KEY=""

# Keep the model configurable so deployments can choose an available Gemini model.
GEMINI_MODEL="gemini-3.5-flash"

PORT=3000
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT=30

# Public production origin used by the API CORS allowlist, for example:
# APP_URL="https://poker-coach.example.com"
APP_URL=""
